# Copy to .env next to docker-compose.yml. Never commit .env.
JWT_SECRET=                 # 32+ random characters: openssl rand -hex 32
POSTGRES_PASSWORD=          # any long random string
GH_XMX=3g                   # GraphHopper memory: 3g serves Italy, 1500m serves central Italy
TUNNEL_TOKEN=               # from Cloudflare Zero Trust → Tunnels (only with --profile tunnel)
CORS_ORIGINS=https://nikkodime.github.io
