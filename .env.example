# Copy to .env (never commit it). Defaults suit local development; see services/api/src/config.ts.
ROUTER=osrm                 # graphhopper in production
GRAPHHOPPER_URL=http://localhost:8989
WEATHER=metno               # MET Norway, CC BY 4.0, commercial use OK
ELEVATION=open-meteo        # dev only (free tier is non-commercial)
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io
DATABASE_URL=               # empty = in-memory store
JWT_SECRET=dev-only-secret-change-me-please
APPLE_BUNDLE_IDS=app.scenicroute.ios
