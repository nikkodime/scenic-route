{
  "name": "scenic-route",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm run test:prototype && npm run test:core && npm run test:api && npm run test:web",
    "test:prototype": "node --test test/*.test.js",
    "test:core": "node --test packages/core/test/*.test.ts",
    "test:api": "node --test services/api/test/app.test.ts services/api/test/providers.test.ts",
    "typecheck": "tsc -p packages/core && tsc -p services/api && tsc -p apps/web",
    "dev:api": "npm run dev -w services/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test:web": "node --test apps/web/test/*.test.ts",
    "test:e2e": "npm run build:web && node apps/web/test/e2e.ts",
    "test:gh": "node --test services/api/test/graphhopper.int.test.ts",
    "openapi": "npm run openapi -w services/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
